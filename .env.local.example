# =============================================================================
# Poddy – Konfiguration
# =============================================================================
# 1. Diese Datei kopieren:   cp .env.local.example .env.local
# 2. Abschnitt "SCHNELLSTART" ausfüllen (ein OpenRouter-Key reicht).
# 3. Starten:                docker compose -f compose.pi.yml up -d --build
#
# Hinweise
# - Werte hier haben Vorrang vor der Weboberfläche; dort erscheinen die Felder
#   dann gesperrt. Zeile löschen oder auskommentieren, um sie wieder in der
#   Oberfläche einzustellen.
# - Nach Änderungen neu starten: docker compose -f compose.pi.yml up -d
# - Keine Anführungszeichen um Werte, keine Leerzeichen um das "=".
# =============================================================================


# -----------------------------------------------------------------------------
# SCHNELLSTART: OpenRouter (Transkription + KI mit einem Key)
# -----------------------------------------------------------------------------
# Key anlegen: https://openrouter.ai/keys  (vorher Guthaben aufladen)
# Damit richtet Poddy automatisch ein:
#   Transkription:  openai/whisper-large-v3-turbo  (ca. 0,01 $ pro Audiostunde)
#   KI (Werbung, Kapitel, Zusammenfassung): ~deepseek/deepseek-flash-latest
#                   (Alias auf das jeweils neueste DeepSeek-Flash-Modell)
# Preise laut OpenRouter, Stand Oktober 2026 – bitte auf openrouter.ai prüfen.
OPENROUTER_API_KEY=sk-or-v1-hier-deinen-key-eintragen

# Standardsprache der Podcasts: de, en, fr, ... oder auto.
# - Feste Sprache (empfohlen): die ganze Folge wird in dieser Sprache
#   transkribiert; fremdsprachige Einspieler werden dabei meist übersetzt.
# - auto: das Modell erkennt die Sprache je Abschnitt (~10 Minuten) selbst.
#   Nur sinnvoll, wenn die Sprache von Folge zu Folge wechselt.
# Abweichende Sprache pro Feed in den Feed-Einstellungen setzen
# (z. B. Darknet Diaries: English).
WHISPER_LANGUAGE=de


# -----------------------------------------------------------------------------
# ANMELDUNG – Pflicht, sobald Poddy aus dem Internet erreichbar ist
# (z. B. über Tailscale Funnel)
# -----------------------------------------------------------------------------
# REQUIRE_AUTH=true
# PODLY_ADMIN_USERNAME=admin
# PODLY_ADMIN_PASSWORD=bitte-ein-langes-passwort
# Zufälligen Wert erzeugen mit:  openssl rand -hex 32
# PODLY_SECRET_KEY=


# -----------------------------------------------------------------------------
# TAILSCALE SERVE / FUNNEL (oder ein anderer Proxy auf demselben Rechner)
# -----------------------------------------------------------------------------
# Damit Feed-Links https:// verwenden, dem Proxy vertrauen. Bei compose.pi.yml
# ist das immer das Docker-Gateway 172.30.42.1.
# PODLY_TRUSTED_PROXY=172.30.42.1
#
# Wichtig dazu: den Port dann nur lokal veröffentlichen, sonst könnte jeder im
# Netz dieselbe Adresse nutzen. Dafür eine Datei ".env" (ohne .local) neben
# compose.pi.yml anlegen mit dem Inhalt:
#   PODDY_BIND_ADDRESS=127.0.0.1
# Erreichbar ist Poddy dann nur noch über Tailscale bzw. auf dem Rechner selbst.


# =============================================================================
# OPTIONAL – alles ab hier nur bei Bedarf
# =============================================================================

# -----------------------------------------------------------------------------
# Andere Modelle bei OpenRouter (überschreiben die Schnellstart-Vorgaben)
# -----------------------------------------------------------------------------
# Transkription mit besserer Qualität / gemischten Sprachen (ca. 20x teurer):
# WHISPER_REMOTE_MODEL=mistralai/voxtral-small-transcribe-3-0   # ca. 0,24 $/h
# WHISPER_REMOTE_MODEL=mistralai/voxtral-mini-transcribe-3-0    # ca. 0,21 $/h
# WHISPER_REMOTE_MODEL=openai/whisper-large-v3                  # ca. 0,03 $/h
#
# Andere KI-Modelle (immer mit "openrouter/" davor):
# Feste Version statt Alias (ändert sich nicht unbemerkt):
# LLM_MODEL=openrouter/deepseek/deepseek-v4.1-flash      # ca. 0,14 $ / 0,42 $ pro Mio.
# LLM_MODEL=openrouter/anthropic/claude-haiku-5.5        # ca. 0,10 $ / 0,50 $ pro Mio.
# LLM_MODEL=openrouter/openai/gpt-6-luna                 # ca. 0,10 $ / 0,50 $ pro Mio.
#
# Upload-Stückgröße in MB (OpenRouter: max. 25 MB und 60 s pro Stück).
# WHISPER_REMOTE_CHUNKSIZE_MB=10

# -----------------------------------------------------------------------------
# Statt OpenRouter: andere Anbieter
# -----------------------------------------------------------------------------
# Groq (Transkription + KI):
# GROQ_API_KEY=gsk_...
# WHISPER_TYPE=groq
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# LLM_MODEL=groq/openai/gpt-oss-120b
#
# OpenAI oder ein anderer OpenAI-kompatibler Dienst:
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=            # nur für eigene/kompatible Server
# WHISPER_TYPE=remote
# WHISPER_REMOTE_API_KEY=sk-...
# WHISPER_REMOTE_BASE_URL=https://api.openai.com/v1
# WHISPER_REMOTE_MODEL=whisper-1
#
# Lokales Whisper (nur mit dem großen Image compose.dev.cpu.yml, langsam auf dem Pi):
# WHISPER_TYPE=local
# WHISPER_LOCAL_MODEL=base

# -----------------------------------------------------------------------------
# Feintuning KI (Standardwerte passen meist)
# -----------------------------------------------------------------------------
# OPENAI_TIMEOUT=300
# OPENAI_MAX_TOKENS=4096
# LLM_MAX_CONCURRENT_CALLS=3
# LLM_MAX_RETRY_ATTEMPTS=5
# LLM_ENABLE_TOKEN_RATE_LIMITING=false
# LLM_MAX_INPUT_TOKENS_PER_CALL=
# LLM_MAX_INPUT_TOKENS_PER_MINUTE=
# WHISPER_REMOTE_TIMEOUT_SEC=600

# -----------------------------------------------------------------------------
# Sonstiges
# -----------------------------------------------------------------------------
# Parallele Web-Threads
# SERVER_THREADS=2
#
# Mehr technische Details im Statistik-Dialog einer Folge (Fehlersuche)
# PODLY_STATS_DEBUG=false
